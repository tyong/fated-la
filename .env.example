# Base site URL for absolute og:image / og:url. Optional locally; on Vercel,
# `npm run build` (scripts/run-build-capture.mjs) sets this from the deployment
# host so Gatsby can inline it (raw VERCEL_* is not available in compiled bundles).
# Preview deployments always use the preview hostname even if you set a prod URL here.
# GATSBY_SITE_URL=https://example.com

# Contact email for footer mailto links (About / Result footer). Required for correct inbox in production.
# GATSBY_CONTACT_EMAIL=hello@yourdomain.com

# Full official candidate list URL (Methodology footer link). Defaults to LA County elections if unset.
# GATSBY_CANDIDATES_LIST_URL=https://www.example.com/candidates

# Optional: footer "Last updated" text. If unset, gatsby-node sets it at build start
# (on Vercel that matches the deploy build). Format example: 29 April 2026
# GATSBY_LAST_UPDATED=

# Optional: share image capture (scripts/capture-share-images.mjs)
# Set to 1 to skip Playwright during `npm run build` (e.g. if Chromium deps fail on a host).
# SKIP_SHARE_CAPTURE=0
# Vercel builds skip Playwright by default (uses committed static/share/*.png). Set to 1 on Vercel
# to force install Chromium + capture (often flaky on CI).
# FORCE_SHARE_CAPTURE=0
# Capture from a live HTTPS URL instead of serving public/ (post-deploy or preview).
# SHARE_CAPTURE_BASE_URL=https://your-site.vercel.app
# Local static server port when using the default (no base URL).
# SHARE_CAPTURE_PORT=9756
# Rare: use whatever PLAYWRIGHT_BROWSERS_PATH the host sets (e.g. IDE sandbox).
# PLAYWRIGHT_USE_HOST_BROWSER_PATH=1
