# Base site URL used to build canonical social preview URLs (og:url).
GATSBY_SITE_URL=https://example.com

# Optional: share image capture (scripts/capture-share-images.mjs)
# Set to 1 to skip Playwright during `npm run build` (e.g. if Chromium deps fail on a host).
# SKIP_SHARE_CAPTURE=0
# Vercel builds skip Playwright by default (uses committed static/share/*.png). Set to 1 on Vercel
# to force install Chromium + capture (often flaky on CI).
# FORCE_SHARE_CAPTURE=0
# Capture from a live HTTPS URL instead of serving public/ (post-deploy or preview).
# SHARE_CAPTURE_BASE_URL=https://your-site.vercel.app
# Local static server port when using the default (no base URL).
# SHARE_CAPTURE_PORT=9756
# Rare: use whatever PLAYWRIGHT_BROWSERS_PATH the host sets (e.g. IDE sandbox).
# PLAYWRIGHT_USE_HOST_BROWSER_PATH=1
